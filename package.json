{
  "name": "findsprop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-client-bundle.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "policy": "node scripts/check-hygiene.mjs && node scripts/check-env.mjs && node scripts/check-deps.mjs && node scripts/check-messages.mjs && node scripts/check-tokens.mjs && node scripts/check-token-parity.mjs && node scripts/check-harness.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run policy",
    "harness:check": "node scripts/check-harness.mjs && vitest run scripts .claude",
    "doctor": "node scripts/doctor.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "gen:types": "node scripts/gen-types.mjs",
    "check:db": "node scripts/check-migrations.mjs && supabase db reset && supabase db lint --level error && supabase test db && node scripts/gen-types.mjs --check",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:ds": "playwright test --project=design-lab --pass-with-no-tests",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "verify": "npm run check && npm run check:db && npm run test:integration && npm run build && npm run test:ds && npm run test:e2e:smoke",
    "prepare": "node scripts/prepare.mjs",
    "knip": "knip"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "client-only": "0.0.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-boundaries": "7.4.0",
    "jsdom": "29.1.1",
    "knip": "6.44.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  }
}
