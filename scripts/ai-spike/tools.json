    {
      "name": "calculate_emi",
      "kind": "read",
      "computed": true,
      "description": "Calculate an example EMI. Modes: emi (monthly instalment from a price or a loan amount), affordability (the largest loan and price for a monthly budget), breakdown (total interest and total paid). Defaults when a field is null: 20 percent down payment, 20 years and an example rate. The result is always an example, not a bank offer.",
      "parameters": {
        "type": "object",
        "properties": {
          "mode": { "type": "string", "enum": ["emi", "affordability", "breakdown"] },
          "priceRupees": {
            "type": ["integer", "null"],
            "description": "Home price in whole rupees."
          },
          "loanAmountRupees": {
            "type": ["integer", "null"],
            "description": "Loan amount in whole rupees."
          },
          "downPaymentPercent": { "type": ["number", "null"] },
          "annualRatePercent": { "type": ["number", "null"] },
          "years": { "type": ["integer", "null"] },
          "monthlyBudgetRupees": { "type": ["integer", "null"] }
        },
        "required": [
          "mode",
          "priceRupees",
          "loanAmountRupees",
          "downPaymentPercent",
          "annualRatePercent",
          "years",
          "monthlyBudgetRupees"
        ],
        "additionalProperties": false
      },
      "results": []
    },
    {
      "name": "propose_enquiry",
      "kind": "propose",
      "computed": false,
      "description": "Prepare an enquiry about one home for the customer to confirm. Sends nothing: the customer confirms with a button. Call this tool on its own, not together with other tools.",
      "parameters": {
        "type": "object",
        "properties": {
          "shortId": { "type": "string" },
          "message": { "type": "string", "description": "The message the customer wants to send." }
        },
        "required": ["shortId", "message"],
        "additionalProperties": false
      },
      "results": [
        {
          "output": {
            "status": "proposal_ready",
            "note": "Nothing has been sent. The customer must confirm on the card that is shown to them."
          }
        }
      ]
    },
    {
      "name": "propose_site_visit",
      "kind": "propose",
      "computed": false,
      "description": "Prepare a site-visit request for one project for the customer to confirm. Sends nothing: the customer confirms with a button. The date is ISO (YYYY-MM-DD), from today to one year ahead. Call this tool on its own, not together with other tools.",
      "parameters": {
        "type": "object",
        "properties": {
          "slug": { "type": "string" },
          "visitDate": { "type": "string", "description": "ISO date, YYYY-MM-DD." },
          "message": { "type": ["string", "null"] }
        },
        "required": ["slug", "visitDate", "message"],
        "additionalProperties": false
      },
      "results": [
        {
          "output": {
            "status": "proposal_ready",
            "note": "Nothing has been sent. The customer must confirm on the card that is shown to them."
          }
        }
      ]
    }
