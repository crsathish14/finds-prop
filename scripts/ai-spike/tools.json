          "propertyType": {
            "type": ["string", "null"],
            "enum": ["apartment", "villa", "independent_house", "plot", null]
          },
          "bhk": { "type": ["integer", "null"], "description": "Number of bedrooms." },
          "minPriceRupees": { "type": ["integer", "null"] },
          "maxPriceRupees": {
            "type": ["integer", "null"],
            "description": "Maximum price in whole rupees. 80 lakh is 8000000."
          },
          "locality": {
            "type": ["string", "null"],
            "description": "Locality name in English letters."
          },
          "keyword": { "type": ["string", "null"] },
          "label": {
            "type": ["string", "null"],
            "description": "Optional label such as new or ready_to_move."
          },
          "sort": {
            "type": ["string", "null"],
            "enum": ["newest", "price_asc", "price_desc", null]
          },
          "limit": { "type": ["integer", "null"], "description": "At most 10." }
        },
        "required": [
          "listingType",
          "propertyType",
          "bhk",
          "minPriceRupees",
          "maxPriceRupees",
          "locality",
