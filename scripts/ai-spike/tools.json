    {
      "name": "search_properties",
      "kind": "read",
      "computed": false,
      "description": "Search approved homes listed on the platform. Returns at most 10 compact results, a total count and an as-of time. Use null for any filter the customer did not give. Prices are whole rupees; rent is per month.",
