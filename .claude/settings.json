{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck)",
      "Bash(npm run format*)",
      "Bash(npm run test*)",
      "Bash(npm run harness:check)",
      "Bash(npm run doctor)",
      "Bash(npm run verify)",
      "Bash(npm run check:db)",
      "Bash(npm run db:start)",
      "Bash(npm run db:stop)",
      "Bash(npm run db:reset)",
      "Bash(npm run gen:types)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh pr merge *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git worktree *)",
      "Bash(git rev-parse *)",
      "Bash(npm ci)",
      "Bash(npm run build)",
      "Bash(npm install --save-exact openai@*)",
      "Bash(npm install openai@*)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:developer.mozilla.org)"
    ],
    "ask": ["Bash(npm uninstall *)", "Bash(npm update *)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production*)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(supabase link*)",
      "Bash(supabase db push*)",
      "Bash(npx supabase link*)",
      "Bash(npx supabase db push*)",
      "Bash(vercel*)",
      "Bash(npx vercel*)",
      "Bash(npm publish*)",
      "Bash(gh release*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edit.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-naming.mjs\""
          }
        ]
      }
    ]
  }
}
