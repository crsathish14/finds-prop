# Names only. Copy to .env.local and fill in values for local development. Never commit .env.local.
# Server-only variables are documented in src/server/env.ts, browser-safe ones in src/lib/public-env.ts.

# --- Environment: local | dev | staging | production
APP_ENV=local

# --- Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (dev project: Dashboard > Project Settings > API; a local stack prints its own with `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth and providers (needed from Stage 3 onwards)
SEND_SMS_HOOK_SECRET=
SMS_PROVIDER=
PING4SMS_API_KEY=
PING4SMS_SENDER_ID=
PING4SMS_TEMPLATE_ID=
PING4SMS_ROUTE=
PING4SMS_MESSAGE=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Enquiry mail through Resend (ADR-181). Leave the key empty and no mail is sent. Dev and staging mail only the addresses listed in MAIL_DEV_ALLOWLIST.
RESEND_API_KEY=
MAIL_FROM=no-reply@findsprop.com
MAIL_REPLY_TO=support@findsprop.com
MAIL_DEV_ALLOWLIST=
OLA_MAPS_API_KEY=
# Place search kill switch: 1 turns every lookup off at once (the search box falls back to typed text). Leave 0 normally.
PLACES_DISABLED=0
NEXT_PUBLIC_MAP_STYLE_URL=
RATE_LIMIT_HMAC_SECRET=

# --- AI chat (optional while FLAG_AI_SEARCH is 0; ADR-128). AI_PROVIDER: fake | openai | gemini
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
# Optional: none | minimal | low | medium | high | xhigh | max. Blank sends nothing (the model default).
AI_REASONING_EFFORT=

# --- Observability (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_BROWSER_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_AUTH_TOKEN=
# Set by Vercel on every deployment; used as the release name for error reports
VERCEL_GIT_COMMIT_SHA=

# --- Feature flags: 0 or 1 (all off by default)
FLAG_AI_SEARCH=0
# AI place search ("homes near KK Nagar" in the chat). Needs FLAG_AI_SEARCH=1 as well and OLA_MAPS_API_KEY. Leave 0 until the owner switches it on.
FLAG_AI_PLACE_SEARCH=0
FLAG_MAP_VIEW=0
FLAG_PG_LISTINGS=0
# Customer email (sign-in email step, dashboard prompt, post-property gate). Leave 0 until Supabase has an email provider.
FLAG_CUSTOMER_EMAIL=0
DESIGN_LAB=0
