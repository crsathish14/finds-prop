# Names only. Copy to .env.local and fill in values for local development. Never commit .env.local.
# Server-only variables are documented in src/server/env.ts, browser-safe ones in src/lib/public-env.ts.

# --- Environment: local | dev | staging | production
APP_ENV=local

# --- Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (dev project: Dashboard > Project Settings > API; a local stack prints its own with `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth and providers (needed from Stage 3 onwards)
SEND_SMS_HOOK_SECRET=
SMS_PROVIDER=
PING4SMS_API_KEY=
PING4SMS_SENDER_ID=
PING4SMS_TEMPLATE_ID=
PING4SMS_ROUTE=
PING4SMS_MESSAGE=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
OLA_MAPS_API_KEY=
NEXT_PUBLIC_MAP_STYLE_URL=
RATE_LIMIT_HMAC_SECRET=

# --- Observability (optional)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Feature flags: 0 or 1 (all off by default)
FLAG_AI_SEARCH=0
FLAG_MAP_VIEW=0
FLAG_PG_LISTINGS=0
DESIGN_LAB=0
